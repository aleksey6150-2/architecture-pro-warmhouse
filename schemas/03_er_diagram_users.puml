@startuml
title ER-диаграмма: База данных пользователей (users_db)

skinparam linetype ortho

entity "t_users" as users {
    * user_id : UUID <<PK>>
    --
    * personal_acc_id INTEGER
    * email : VARCHAR(255) <<UNIQUE>>
    * password_hash : VARCHAR(255)
    * phone : VARCHAR(20)
    first_name : VARCHAR(100)
    last_name : VARCHAR(100)
    * role : ENUM('owner', 'support', 'admin')
    * status : ENUM('active', 'blocked', 'pending')
    * created_at : TIMESTAMP
    updated_at : TIMESTAMP
    last_login_at : TIMESTAMP
}

entity "t_homes" as homes {
    * home_id : UUID <<PK>>
    --
    * owner_id : UUID <<FK>>
    * name : VARCHAR(255)
    address : VARCHAR(500)
    timezone : VARCHAR(50)
    * created_at : TIMESTAMP
}

entity "t_user_permissions" as permissions {
    * permission_id : UUID <<PK>>
    --
    * user_id : UUID <<FK>>
    * home_id : UUID <<FK>>
    * permission_type : ENUM('view', 'control', 'manage')
    * granted_at : TIMESTAMP
    granted_by : UUID <<FK>>
}

users ||--o{ homes : "владеет"
users ||--o{ permissions : "имеет"
homes ||--o{ permissions : "для дома"

@enduml